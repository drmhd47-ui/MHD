---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import TrackRecord from '../../components/TrackRecord.astro';
import AxisList from '../../components/AxisList.astro';
import People from '../../components/People.astro';
import Coverage from '../../components/Coverage.astro';
import hero from '../../assets/kafd-night.jpg';
import { langPaths } from '../../lib/paths';
import { path, t } from '../../i18n';
import type { Lang } from '../../data/catalog';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const s = t[lang];
---

<Base lang={lang} title={s.siteName} description={s.hero.lead} route="">
  <section class="hero">
    <Picture
      src={hero}
      alt=""
      formats={['avif']}
      widths={[640, 1080]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-img"
    />
    <div class="wrap hero-body">
      <p class="eyebrow">{s.hero.eyebrow}</p>
      <h1>{s.hero.title}</h1>
      <p class="hero-tag">{s.tagline}</p>
      <p class="hero-lead">{s.hero.lead}</p>
      <div class="actions">
        <a class="btn btn--primary" href={path(lang, 'contact') + '#request'}>{s.cta}</a>
        <a class="btn btn--ghost" href={path(lang, 'services')}>{s.hero.secondary}</a>
      </div>
      <TrackRecord lang={lang} showSummary />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">{s.about.eyebrow}</p>
        <h2>{s.about.title}</h2>
        <p class="lead">{s.about.p1}</p>
        <p>{s.about.p2}</p>
        <p><a href={path(lang, 'about')}>{s.about.more}</a></p>
      </div>
      <div>
        <h3>{s.about.methodTitle}</h3>
        <ol class="method">
          {
            s.about.method.map((m) => (
              <li>
                <strong>{m.t}</strong>
                <span>{m.d}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--shade" id="services">
    <div class="wrap">
      <p class="eyebrow">{s.services.eyebrow}</p>
      <h2>{s.services.title}</h2>
      <p class="lead">{s.services.lead}</p>
      <AxisList lang={lang} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>{s.people.title}</h2>
      <People lang={lang} />
    </div>
  </section>

  <section class="section section--shade">
    <div class="wrap">
      <p class="eyebrow">{s.coverage.eyebrow}</p>
      <h2>{s.coverage.title}</h2>
      <p class="lead">{s.coverage.lead}</p>
      <Coverage lang={lang} />
    </div>
  </section>

  <section class="section section--dark cta-band">
    <div class="wrap">
      <h2>{s.contact.title}</h2>
      <p class="lead">{s.contact.lead}</p>
      <a class="btn btn--primary" href={path(lang, 'contact') + '#request'}>{s.cta}</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--navy-deep);
    color: var(--on-dark);
    overflow: hidden;
  }
  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 45%;
    z-index: -2;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, color-mix(in srgb, var(--navy-deep) 70%, transparent) 0%, color-mix(in srgb, var(--navy-deep) 82%, transparent) 55%, var(--navy-deep) 100%);
  }
  .hero-body {
    padding-block: clamp(4rem, 12vw, 8rem) clamp(2.5rem, 6vw, 4rem);
  }
  .hero h1 {
    color: var(--on-dark);
    margin-bottom: 0.2rem;
  }
  .hero-tag {
    color: var(--gold);
    font-size: var(--step-2);
    font-weight: 700;
    margin-bottom: 1rem;
  }
  .hero-lead {
    color: var(--on-dark-soft);
    font-size: var(--step-1);
    max-width: 60ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 1.5rem 2.25rem;
  }
  .split {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    align-items: start;
  }
  .method {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    counter-reset: m;
  }
  .method li {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--gold);
    border-radius: var(--radius);
  }
  .method strong {
    color: var(--navy);
  }
  .method span {
    color: var(--ink-soft);
  }
  .cta-band {
    text-align: center;
  }
  .cta-band .lead {
    margin-inline: auto;
  }
</style>
