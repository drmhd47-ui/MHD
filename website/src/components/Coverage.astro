---
import { company } from '../data/company';
import { t } from '../i18n';
import type { Lang } from '../data/catalog';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<ul class="coverage grid grid--3">
  {
    company.coverage.map((c) => (
      <li class:list={['card', { hq: 'hq' in c && c.hq }]}>
        <strong>{c[lang].city}</strong>
        <span>{c[lang].region}</span>
        {'hq' in c && c.hq && <span class="badge">{t[lang].coverage.hq}</span>}
      </li>
    ))
  }
</ul>

<style>
  .coverage {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    gap: 0.2rem;
    border-inline-start: 3px solid var(--line);
  }
  li.hq {
    border-inline-start-color: var(--gold);
  }
  strong {
    color: var(--navy);
    font-size: var(--step-1);
  }
  span {
    color: var(--ink-soft);
  }
  .badge {
    justify-self: start;
    margin-top: 0.4rem;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--navy);
    border: 1px solid var(--gold);
    border-radius: 999px;
    padding: 0 0.7rem;
  }
</style>
