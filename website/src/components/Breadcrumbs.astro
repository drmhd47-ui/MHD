---
import { t } from '../i18n';
import type { Lang } from '../data/catalog';

interface Props {
  lang: Lang;
  /** آخر عنصر هو الصفحة الحالية */
  items: { label: string; href: string }[];
}
const { lang, items } = Astro.props;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((i, n) => ({
    '@type': 'ListItem',
    position: n + 1,
    name: i.label,
    item: new URL(i.href, Astro.site).href
  }))
};
---

<nav aria-label={t[lang].breadcrumb} class="crumbs">
  <ol>
    {
      items.map((i, n) =>
        n === items.length - 1 ? (
          <li aria-current="page">{i.label}</li>
        ) : (
          <li>
            <a href={i.href}>{i.label}</a>
          </li>
        )
      )
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    font-size: var(--step--1);
    color: var(--on-dark-soft);
  }
  .crumbs li + li::before {
    content: '‹';
    margin-inline-end: 0.5rem;
    color: var(--gold);
  }
  :global([dir='ltr']) .crumbs li + li::before {
    content: '›';
  }
  .crumbs a {
    color: var(--on-dark-soft);
  }
</style>
