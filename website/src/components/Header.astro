---
import logo from '../assets/logo-mark.svg';
import { other, path, t } from '../i18n';
import { publishedArticles } from '../lib/articles';
import type { Lang } from '../data/catalog';

interface Props {
  lang: Lang;
  route: string;
}
const { lang, route } = Astro.props;
const s = t[lang];
const hasArticles = (await publishedArticles(lang)).length > 0;

const items = [
  { key: 'about', href: path(lang, 'about'), label: s.nav.about },
  { key: 'services', href: path(lang, 'services'), label: s.nav.services },
  { key: 'coverage', href: path(lang, 'coverage'), label: s.nav.coverage },
  ...(hasArticles ? [{ key: 'articles', href: path(lang, 'articles'), label: s.nav.articles }] : []),
  { key: 'contact', href: path(lang, 'contact'), label: s.nav.contact }
];
const current = route.split('/')[0];
// مقالات بلغة واحدة لا مقابل لها: زر اللغة يعود إلى قائمة المقالات في اللغة الأخرى.
const altRoute = current === 'articles' ? 'articles' : route;
const altHref = path(other(lang), altRoute);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={path(lang)} aria-label={`${s.siteName} — ${s.nav.home}`}>
      <span class="plate"><img src={logo.src} width="83" height="80" alt="" /></span>
      <span class="brand-text">
        <span class="brand-name">{s.siteName}</span>
        <span class="brand-sub">{lang === 'ar' ? 'M GROUP' : 'Law Firm & Legal Consultancy'}</span>
      </span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-button>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      <span data-label-open>{s.menu}</span><span data-label-close hidden>{s.close}</span>
    </button>

    <nav id="site-nav" class="nav" aria-label={s.menu} data-nav>
      <ul>
        {
          items.map((i) => (
            <li>
              <a href={i.href} aria-current={current === i.key ? 'page' : undefined}>
                {i.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav-actions">
        <a class="lang" href={altHref} hreflang={other(lang)} lang={other(lang)} aria-label={s.switchLangLabel}>{s.switchLang}</a>
        <a class="btn btn--primary" href={path(lang, 'contact') + '#request'}>{s.cta}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (btn && nav) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('open', open);
      btn.querySelector('[data-label-open]')!.toggleAttribute('hidden', open);
      btn.querySelector('[data-label-close]')!.toggleAttribute('hidden', !open);
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        btn.focus();
      }
    });
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--navy-deep);
    color: var(--on-dark);
    border-bottom: 1px solid var(--line-dark);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-block-size: 6.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--on-dark);
    text-decoration: none;
  }
  .plate {
    display: grid;
    place-items: center;
    background: var(--cream);
    border: 1px solid var(--gold);
    border-radius: 0.5rem;
    padding: 0.3rem 0.4rem;
  }
  /* الحد الأدنى للشعار في الهوية: أن تبقى كلمة GROUP مقروءة — لذا لا يقل ارتفاعه عن 4.25rem. */
  .plate img {
    display: block;
    block-size: 5rem;
    inline-size: auto;
  }
  @media (max-width: 40rem) {
    .plate img {
      block-size: 4.25rem;
    }
  }
  .brand-text {
    display: grid;
    line-height: 1.3;
  }
  .brand-name {
    font-weight: 700;
    font-size: 1.15rem;
  }
  .brand-sub {
    font-size: 0.8rem;
    color: var(--on-dark-soft);
    letter-spacing: 0.04em;
  }
  .menu-btn {
    display: none;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-weight: 700;
    color: var(--on-dark);
    background: transparent;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    padding: 0.4rem 0.8rem;
    min-block-size: 2.75rem;
    cursor: pointer;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    display: block;
    padding: 0.5rem 0.75rem;
    color: var(--on-dark);
    text-decoration: none;
    border-radius: var(--radius);
    border-bottom: 2px solid transparent;
  }
  .nav ul a:hover,
  .nav ul a[aria-current='page'] {
    border-bottom-color: var(--gold);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lang {
    color: var(--on-dark);
    padding: 0.5rem 0.5rem;
  }
  @media (max-width: 62rem) {
    .menu-btn {
      display: inline-flex;
    }
    .nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      background: var(--navy-deep);
      border-bottom: 1px solid var(--line-dark);
      padding: 1rem var(--gutter) 1.5rem;
      flex-direction: column;
      align-items: stretch;
    }
    .nav.open {
      display: flex;
    }
    .nav ul {
      flex-direction: column;
    }
    .nav ul a {
      padding: 0.75rem 0.5rem;
      border-bottom: 1px solid var(--line-dark);
      border-radius: 0;
    }
    .nav-actions {
      justify-content: space-between;
    }
  }
  @media (max-width: 26rem) {
    .brand-sub {
      display: none;
    }
  }
</style>
