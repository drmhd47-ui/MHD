---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Lang } from '../data/catalog';

interface Props {
  lang: Lang;
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; href: string }[];
}
const { lang, eyebrow, title, lead, crumbs = [] } = Astro.props;
---

<section class="page-head section--dark">
  <div class="wrap">
    {crumbs.length > 0 && <Breadcrumbs lang={lang} items={crumbs} />}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-bottom: 3px solid var(--gold);
  }
  h1 {
    color: var(--on-dark);
    font-size: var(--step-3);
  }
</style>
