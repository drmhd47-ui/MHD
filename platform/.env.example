NEXUS_DATABASE_URL=postgresql://nexus:CHANGE_ME@db:5432/nexus
NEXUS_RAW_STORAGE_DIR=/data/raw
# Identify the crawler to site operators (email or URL of the responsible party)
NEXUS_CRAWLER_CONTACT=
NEXUS_REQUEST_DELAY_SECONDS=3
# Phase 1 reviewer access: comma-separated name:token (token >= 24 chars; generate with `openssl rand -hex 24`)
NEXUS_REVIEWER_TOKENS=
# extractive (no model, quotes texts only) | claude (after the PDPL transfer assessment — see README)
NEXUS_LLM_PROVIDER=extractive
ANTHROPIC_API_KEY=
NEXUS_CLAUDE_MODEL=claude-opus-5-5
NEXUS_CLAUDE_EFFORT=medium
NEXUS_LOCAL_ONLY_CATEGORIES=criminal,personal_status,health
