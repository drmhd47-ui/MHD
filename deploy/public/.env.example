# مفتاح تشفير الطلبات المخزنة مؤقتاً — openssl rand -base64 32
INTAKE_ENCRYPTION_KEY=
# السر المشترك مع النظام الداخلي لتوقيع الطلبات — openssl rand -base64 48
# يجب أن يطابق Intake__SharedSecret في النظام الداخلي تماماً.
INTAKE_SHARED_SECRET=
# عنوان نقطة الاستلام في النظام الداخلي، عبر شبكة خاصة (VPN/شبكة افتراضية) لا عبر الإنترنت العام
INTERNAL_API_URL=https://internal.example.local/api/internal/intake-requests
ALLOWED_ORIGINS=https://www.mgrp.sa,https://mgrp.sa

# بريد الإشعار الآلي للعميل (اختياري؛ بدونه لا تُرسل رسالة تأكيد)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM="مجموعة إم القانونية <no-reply@mgrp.sa>"
