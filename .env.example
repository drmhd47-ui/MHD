# قاعدة البيانات
DB_SA_PASSWORD=

# JWT — أنشئه بالأمر: openssl rand -base64 48
JWT_KEY=
JWT_ISSUER=mhd-legal
JWT_AUDIENCE=mhd-legal-client

# مفتاح تشفير الحقول الحساسة (32 بايت بالضبط بعد فك base64) — أنشئه بالأمر: openssl rand -base64 32
STORAGE_KEY=

# نطاق الواجهة المسموح به عبر CORS (نطاق فرعي خاص بالمكتب، وليس IP)
PUBLIC_ORIGIN=https://your-firm-domain.example

# حساب المدير الأولي — يُطلب تغيير كلمة المرور وتفعيل المصادقة الثنائية عند أول دخول
MANAGER_EMAIL=manager@firm.sa
MANAGER_TEMP_PASSWORD=
